{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "yukidesign.vercel.app"
        }
      ],
      "destination": "https://yukidesign.yukidsgn.com/:path",
      "permanent": true
    }
  ]
}
